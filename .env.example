# API Laravel core (Synkai) — panel consume /api/v1/admin/*
VITE_ADMIN_API_BASE_URL=https://api.tbnliving.com
# Sanctum SPA cross-subdomain (cookies + CSRF). Obligatorio en producción.
VITE_API_WITH_CREDENTIALS=true

# Desarrollo: dejar vacío base URL y usar proxy Vite (vite.config.js → localhost:8000)
# VITE_ADMIN_API_BASE_URL=
# VITE_API_WITH_CREDENTIALS=true
